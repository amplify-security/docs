{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Amplify Security",
  "colors": {
    "primary": "#9933ff",
    "light": "#a64dff",
    "dark": "#b366ff"
  },
  "fonts": {
    "family": "Roboto, sans-serif"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Amplify Console",
        "icon": "terminal",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "install-console"
            ]
          },
          {
            "group": "Agents & detections",
            "pages": [
              "agents/overview",
              "agents/how-agents-work",
              "agents/writing-an-agent",
              "agents/artifact-kinds",
              "agents/library",
              "agents/skills",
              "agents/detections",
              "agents/tool-reference"
            ]
          },
          {
            "group": "Data & connections",
            "pages": [
              "data/overview",
              "data/projects",
              "data/connections",
              "data/what-agents-can-read",
              "data/findings"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/overview",
              "integrations/connecting",
              "integrations/using-in-agents",
              "integrations/slack",
              "integrations/atlassian",
              "integrations/linear",
              "integrations/notion",
              "integrations/asana",
              "integrations/google"
            ]
          },
          {
            "group": "Working interactively",
            "pages": [
              "interactive/chat",
              "interactive/cli"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "workflows/overview",
              "workflows/create-a-workflow",
              "workflows/agent-chain",
              "workflows/triggers",
              "workflows/outputs",
              "workflows/running",
              "workflows/artifacts"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/console-pages",
              "console/organization",
              "console/billing",
              "console/profile"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Blog",
          "href": "https://amplify.security/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/logomark.png",
    "dark": "/logo/logomark.png",
    "href": "https://amplify.security"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@amplify.security"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign In",
      "href": "https://console.amplify.security/"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/amplify-security",
      "linkedin": "https://www.linkedin.com/company/amplify-security/"
    }
  },
  "redirects": [
    {
      "source": "/harness/overview",
      "destination": "/agents/overview"
    },
    {
      "source": "/harness/agents",
      "destination": "/agents/how-agents-work"
    },
    {
      "source": "/harness/writing-an-agent",
      "destination": "/agents/writing-an-agent"
    },
    {
      "source": "/harness/agent-library",
      "destination": "/agents/library"
    },
    {
      "source": "/harness/skills",
      "destination": "/agents/skills"
    },
    {
      "source": "/harness/detections",
      "destination": "/agents/detections"
    },
    {
      "source": "/harness/tool-reference",
      "destination": "/agents/tool-reference"
    },
    {
      "source": "/context/overview",
      "destination": "/data/overview"
    },
    {
      "source": "/context/projects",
      "destination": "/data/projects"
    },
    {
      "source": "/context/connections",
      "destination": "/data/connections"
    },
    {
      "source": "/context/vendor-data",
      "destination": "/data/what-agents-can-read"
    },
    {
      "source": "/context/findings",
      "destination": "/data/findings"
    },
    {
      "source": "/workflows/agents",
      "destination": "/workflows/agent-chain"
    },
    {
      "source": "/legacy/:path*",
      "destination": "/introduction"
    }
  ]
}
