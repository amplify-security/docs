{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Amplify Security",
  "colors": {
    "primary": "#9933ff",
    "light": "#a64dff",
    "dark": "#b366ff"
  },
  "fonts": {
    "family": "Roboto, sans-serif"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "anchors": [
      {
        "anchor": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "install-console"
            ]
          },
          {
            "group": "Amplify (Legacy Platform)",
            "pages": [
              "legacy/introduction",
              "legacy/quickstart",
              "legacy/sample-project",
              {
                "group": "How-to Guides",
                "pages": [
                  "legacy/guides/ignoring-vulns",
                  "legacy/guides/enable-comments"
                ]
              },
              {
                "group": "Integrations",
                "pages": [
                  "legacy/integrations/github",
                  "legacy/integrations/gitlab"
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub App (Preview)",
          "href": "https://github.com/apps/console-lab",
          "icon": "code-simple"
        },
        {
          "anchor": "Blog",
          "href": "https://amplify.security/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/logomark.png",
    "dark": "/logo/logomark.png",
    "href": "https://amplify.security"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@amplify.security"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign In",
      "href": "https://app.console.lab.amplify.security/"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/amplify-security",
      "linkedin": "https://www.linkedin.com/company/amplify-security/"
    }
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/legacy/quickstart"
    },
    {
      "source": "/sample-project",
      "destination": "/legacy/sample-project"
    },
    {
      "source": "/guides/ignoring-vulns",
      "destination": "/legacy/guides/ignoring-vulns"
    },
    {
      "source": "/guides/enable-comments",
      "destination": "/legacy/guides/enable-comments"
    },
    {
      "source": "/integrations/github",
      "destination": "/legacy/integrations/github"
    },
    {
      "source": "/integrations/gitlab",
      "destination": "/legacy/integrations/gitlab"
    }
  ]
}
