{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Amplify Security",
  "colors": {
    "primary": "#9933ff",
    "light": "#a64dff",
    "dark": "#b366ff"
  },
  "fonts": {
    "family": "Roboto, sans-serif"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Amplify Console",
        "icon": "terminal",
        "global": {
          "anchors": [
            {
              "anchor": "GitHub App (Preview)",
              "href": "https://github.com/apps/console-staging",
              "icon": "code-simple"
            }
          ]
        },
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "install-console"
            ]
          },
          {
            "group": "The Harness",
            "pages": [
              "harness/overview",
              "harness/agents",
              "harness/writing-an-agent",
              "harness/agent-library",
              "harness/skills",
              "harness/detections",
              "harness/tool-reference"
            ]
          },
          {
            "group": "Context",
            "pages": [
              "context/overview",
              "context/projects",
              "context/connections",
              "context/vendor-data",
              "context/findings"
            ]
          },
          {
            "group": "Working interactively",
            "pages": [
              "interactive/chat",
              "interactive/cli"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "workflows/overview",
              "workflows/create-a-workflow",
              "workflows/agent-chain",
              "workflows/triggers",
              "workflows/outputs",
              "workflows/running",
              "workflows/artifacts"
            ]
          }
        ]
      },
      {
        "tab": "Amplify Dashboard (Legacy)",
        "icon": "clock-rotate-left",
        "global": {
          "anchors": [
            {
              "anchor": "GitHub App",
              "href": "https://github.com/apps/amplify-security",
              "icon": "code-simple"
            },
            {
              "anchor": "GitHub Action",
              "href": "https://github.com/marketplace/actions/amplify-runner-action",
              "icon": "circle-play"
            },
            {
              "anchor": "GitLab Component",
              "href": "https://gitlab.com/amplify-security/components",
              "icon": "circle-play"
            }
          ]
        },
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "legacy/introduction",
              "legacy/quickstart",
              "legacy/sample-project"
            ]
          },
          {
            "group": "How-to Guides",
            "pages": [
              "legacy/guides/ignoring-vulns",
              "legacy/guides/enable-comments"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "legacy/integrations/github",
              "legacy/integrations/gitlab"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Blog",
          "href": "https://amplify.security/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/logomark.png",
    "dark": "/logo/logomark.png",
    "href": "https://amplify.security"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@amplify.security"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign In",
      "href": "https://app.console.stg.amplify.security/"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/amplify-security",
      "linkedin": "https://www.linkedin.com/company/amplify-security/"
    }
  },
  "redirects": [
    {
      "source": "/workflows/agents",
      "destination": "/workflows/agent-chain"
    },
    {
      "source": "/sample-project",
      "destination": "/legacy/sample-project"
    },
    {
      "source": "/guides/ignoring-vulns",
      "destination": "/legacy/guides/ignoring-vulns"
    },
    {
      "source": "/guides/enable-comments",
      "destination": "/legacy/guides/enable-comments"
    },
    {
      "source": "/integrations/github",
      "destination": "/legacy/integrations/github"
    },
    {
      "source": "/integrations/gitlab",
      "destination": "/legacy/integrations/gitlab"
    }
  ]
}
